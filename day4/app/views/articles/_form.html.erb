<%= form_with model: article, local: true, class: "article-form" do |form| %>
  <% if article.errors.any? %>
    <div class="error-messages">
      <h4><%= pluralize(article.errors.count, "error") %> prohibited this article from being saved:</h4>
      <ul>
        <% article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-input", placeholder: "Enter a catchy title" %>
  </div>

  <div class="form-group">
    <%= form.label :body, class: "form-label" %>
    <%= form.text_area :body, rows: 6, class: "form-input form-textarea", placeholder: "Write your article content here..." %>
  </div>

  <div class="form-group-checkbox">
    <%= form.check_box :public, class: "form-checkbox" %>
    <%= form.label :public, "Make this article public (anyone can view it)", class: "form-checkbox-label" %>
  </div>

  <div class="form-group">
    <%= form.label :image, "Attach Image", class: "form-label" %>
    <%= form.file_field :image, accept: 'image/*', class: "form-file" %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", articles_path, class: "btn btn-secondary" %>
  </div>
<% end %>
